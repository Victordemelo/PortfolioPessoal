# O Caddy só serve HTTP interno na porta 80 do container (SITE_ADDRESS=":80",
# nunca o domínio). Em produção fica atrás do Nginx do servidor, que faz o
# HTTPS com Certbot e repassa o Host original; por isso o redirect de www abaixo
# continua funcionando.
{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	# www → domínio principal, para o Google ver um endereço só
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Arquivos com hash no nome podem ficar em cache para sempre
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Imagens e ícones de public/: um dia
	@estaticos path *.png *.svg *.webmanifest
	header @estaticos Cache-Control "public, max-age=86400"

	# HTML, robots e sitemap sempre revalidam, para o deploy novo aparecer na hora
	@html not path /assets/* *.png *.svg *.webmanifest
	header @html Cache-Control "no-cache"

	# Robôs de varredura pedem /.env, /.git/config e afins o tempo todo: arquivo
	# oculto nunca existe aqui, então recusa sem nem procurar
	@ocultos path_regexp /\.
	respond @ocultos 404

	# /projetos/<id> tem página própria gerada no build (projetos/<id>/index.html).
	# Caminho que não existe responde 404 (com o site, para quem errou o link),
	# em vez de 200: assim nem o Google nem os robôs acham que ali tem algo
	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /index.html
		file_server
	}
}
