# SITE_ADDRESS vem do .env. Com um domínio (ex.: victordemelo.dev) o Caddy
# emite o HTTPS sozinho; sem ele, serve em http://localhost.
{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Arquivos com hash no nome podem ficar em cache para sempre
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# O index.html sempre revalida, para o deploy novo aparecer na hora
	@html path / /index.html
	header @html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
