# Local: deixe como está e abra http://localhost:8088
SITE_ADDRESS=:80
HTTP_PORT=8088

# Produção (atrás do Nginx do servidor, que cuida do HTTPS com Certbot):
# SITE_ADDRESS=:80
# HTTP_PORT=8080
#
# SITE_ADDRESS nunca deve ser o domínio: o Caddy tentaria emitir um certificado
# próprio e escutar a 443, duplicando o trabalho do Nginx.
# Nenhuma variável VITE_ com segredo: tudo com esse prefixo vai para o JS público.
